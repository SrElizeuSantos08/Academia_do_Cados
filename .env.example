# Exemplo sem credenciais. Configurar valores reais na hospedagem, fora do Git.
ACADEMY_EMAIL_PROVIDER=microsoft365
ACADEMY_PUBLIC_URL=https://academiadocaos.bbsone.com.br
ACADEMY_EMAIL_FROM="Academia do Caos <academiadocaos@bbsone.com.br>"
M365_MAILBOX_UPN=academiadocaos@bbsone.com.br
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Opcional: somente se ACADEMY_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Supabase server-side cutover. Keep the service role key in the hosting secret store only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Preferred protected server credential. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Set explicitly only after reconciliation; default remains d1.
ACADEMY_DATABASE_PROVIDER=d1
# Optional maintenance window: on blocks LMS writes. Omit during normal use.
# ACADEMY_MIGRATION_READONLY=on

